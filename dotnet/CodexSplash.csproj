<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标 .NET Framework 4.8：Win10/11 系统自带，用户无需安装任何运行时 -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CodexSplash</AssemblyName>
    <RootNamespace>CodexSplash</RootNamespace>
    <ApplicationIcon>..\assets\codex.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>Codex Splash</AssemblyTitle>
    <Product>Dragon Splash Boot</Product>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 没有装 Visual Studio 的机器也能编译 net48 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
